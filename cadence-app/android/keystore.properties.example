# Copy this file to keystore.properties (gitignored) and fill in real values
# after generating a release keystore:
#
#   keytool -genkey -v -keystore cadence-release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias cadence
#
# Store the .jks file and these passwords somewhere safe outside the repo —
# losing them means you can never publish an update to the same Play Store
# listing again.

storeFile=/absolute/path/to/cadence-release.jks
storePassword=
keyAlias=cadence
keyPassword=
